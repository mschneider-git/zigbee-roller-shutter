# Proof of concept without the carrier board: bare H2-Zero, Dupont wires.
# Only the battery divider (1 MOhm / 220 kOhm on IO4), no motor terminals,
# no solar input, no 32 kHz crystal.
#
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.poc" build
#
# Delete the generated sdkconfig first when switching between the variants.

# Not fitted
CONFIG_SHUTTER_MOTOR_P_ADC_GPIO=-1
CONFIG_SHUTTER_MOTOR_N_ADC_GPIO=-1
CONFIG_SHUTTER_SOLAR_ADC_GPIO=-1

# No 32 kHz crystal: internal RC oscillator instead of a failing crystal start
CONFIG_RTC_CLK_SRC_EXT_CRYS=n
CONFIG_RTC_CLK_SRC_INT_RC=y

# Bench test: readable logs on the USB console
CONFIG_LOG_DEFAULT_LEVEL_WARN=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The USB console does not survive power management on the ESP32-H2 (IDF v5.5.4):
# CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION holds its no-light-sleep lock as specified, but
# USB still drops after 1-3 minutes once esp_pm_configure() runs with light_sleep_enable,
# even without a single light sleep (cause unknown, bench test 2026-10-07). So no power
# management on the bench; measure the sleep current with the regular build and without USB.
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
CONFIG_IEEE802154_SLEEP_ENABLE=n
